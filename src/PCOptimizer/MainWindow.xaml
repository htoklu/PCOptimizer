<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Optimizer — Oyun Performans Aracı"
        Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B7B9C0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="PC Optimizer" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Valorant, CS2 ve benzeri oyunlar için gerçek, geri alınabilir sistem ayarları" FontSize="13"/>
        </StackPanel>

        <!-- Uyarı / durum -->
        <Border Grid.Row="1" Background="#1B1E27" CornerRadius="8" Padding="12" Margin="0,12,0,12">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"
                       Text="Bu araç, Windows'un belgelenmiş ayarlarını değiştirir. Mucizevi bir 'gizli hızlandırma' yoktur; her adım şeffaftır ve tek tıkla geri alınabilir. Yönetici olarak çalıştırın."/>
        </Border>

        <!-- Optimizasyon listesi -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StepsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#161922" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="24,4,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Butonlar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,10" HorizontalAlignment="Left">
            <Button x:Name="ApplyButton" Content="Seçilenleri Uygula" Background="#3A8DFF" Click="ApplyButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="RestoreButton" Content="Eski Haline Döndür" Background="#4B4F5A" Click="RestoreButton_Click"/>
        </StackPanel>

        <!-- Log kutusu -->
        <Border Grid.Row="4" Background="#0B0D12" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#7CFC9E"/>
            </ScrollViewer>
        </Border>

        <!-- Destek / Support -->
        <Border Grid.Row="5" Margin="0,14,0,0" Padding="10,8" Background="#12141B" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="💰 Support — Bu araç işine yaradıysa geliştirilmeye devam etmesine destek olabilirsin"
                           FontSize="11" Foreground="#8C8F98" Margin="0,0,0,6"/>
                <WrapPanel>
                    <Button x:Name="KofiButton" Content="☕ Ko-fi" FontSize="11" Padding="10,4" Margin="0,0,8,0"
                            Background="#29ABE0" Click="KofiButton_Click"/>
                    <Button x:Name="EmailButton" Content="📧 Email" FontSize="11" Padding="10,4" Margin="0,0,8,0"
                            Background="#4B4F5A" Click="EmailButton_Click"/>
                    <Button x:Name="IbanButton" Content="💳 IBAN Kopyala" FontSize="11" Padding="10,4" Margin="0,0,8,0"
                            Background="#4B4F5A" Click="IbanButton_Click"/>
                    <Button x:Name="UsdtButton" Content="₿ USDT (TRC20) Kopyala" FontSize="11" Padding="10,4"
                            Background="#4B4F5A" Click="UsdtButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
